{
  "name": "@scope/noc-browser",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "tsc -p tsconfig.test.json --noEmit && vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "fetch-cookie": "^3.0.1",
    "tough-cookie": "^4.1.4"
  }
}
