{
  "name": "@scope/noc-cli",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "noc-browser": "./dist/noc-browser.js",
    "noc-client": "./dist/noc-client.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "tsc -p tsconfig.test.json --noEmit && vitest run --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@rhanna/noc-browser": "0.0.0",
    "@scope/noc-client": "0.0.0",
    "tough-cookie": "^4.1.4"
  }
}
