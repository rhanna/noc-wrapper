            "text": "<!DOCTYPE HTML>\r\n<html>\r\n<head>\r\n    <script type='text/javascript' src=\"/RaidoMobile/AppInsights/ai.2.min.js\"></script>\r\n    <script type='text/javascript'>\r\n        let appInsights = new Microsoft.ApplicationInsights.ApplicationInsights({ config: {\r\n            instrumentationKey:\"80642c30-ac26-49de-9af5-cfb7fc3ae735\"\r\n        }});      \r\n        \r\n        appInsights.loadAppInsights();         \r\n                \r\n        appInsights.setAuthenticatedUserContext(\"11538\", \"11538\");  \r\n        appInsights.context.user.id = \"11538\";\r\n        \r\n        appInsights.addTelemetryInitializer(function (envelope) {\r\n           envelope.tags[\"ai.cloud.role\"] = \"Raido Mobile Browser\";\r\n           envelope.tags[\"ai.cloud.roleInstance\"] = \"910401\";\r\n        });\r\n\r\n        appInsights.trackPageView();\r\n    </script>\r\n\r\n    <style>\r\n        .dot {\r\n            height: 14px;\r\n            width: 14px;\r\n            background-color: red;\r\n            border-radius: 50%;\r\n            display: inline-block;\r\n            position: absolute;\r\n            right: 4px;\r\n            bottom: 0px;\r\n        }\r\n        .dotCounter {\r\n            color: white;\r\n              font-size:9px;\r\n              position:absolute;\r\n              bottom:3px;\r\n              right:4px;\r\n        }\r\n       \r\n    </style>\r\n\r\n    <meta name=\"viewport\" content=\"initial-scale=1, maximum-scale=1, user-scalable=no, width=device-width\" /><meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black\" /><meta name=\"apple-mobile-web-app-capable\" content=\"yes\" /><meta http-equiv=\"X-UA-Compatible\" content=\"IE=9\" /><title>\r\n\tN-OC | Mobile (POE-RATATOSK.NOC)\r\n</title>\r\n    <!-- iPhone -->\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-icon-57x57.png?v=24.7.15\"\r\n        sizes=\"57x57\" rel=\"apple-touch-icon\" />\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-startup-image-320x460.png?v=24.7.15\"\r\n        media=\"(device-width: 320px) and (device-height: 480px) and (-webkit-device-pixel-ratio: 1)\"\r\n        rel=\"apple-touch-startup-image\" />\r\n    <!-- iPhone (Retina) -->\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-icon-114x114.png?v=24.7.15\"\r\n        sizes=\"114x114\" rel=\"apple-touch-icon\" />\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-startup-image-640x920.png?v=24.7.15\"\r\n        media=\"(device-width: 320px) and (device-height: 480px) and (-webkit-device-pixel-ratio: 2)\"\r\n        rel=\"apple-touch-startup-image\" />\r\n    <!-- iPhone 5 -->\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-startup-image-640x1096.png?v=24.7.15\"\r\n        media=\"(device-width: 320px) and (device-height: 568px) and (-webkit-device-pixel-ratio: 2)\"\r\n        rel=\"apple-touch-startup-image\" />\r\n    <!-- iPad -->\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-icon-72x72.png?v=24.7.15\"\r\n        sizes=\"72x72\" rel=\"apple-touch-icon\" />\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-startup-image-768x1004.png?v=24.7.15\"\r\n        media=\"(device-width: 768px) and (device-height: 1024px) and (orientation: portrait) and (-webkit-device-pixel-ratio: 1)\"\r\n        rel=\"apple-touch-startup-image\" />\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-startup-image-748x1024.png?v=24.7.15\"\r\n        media=\"(device-width: 768px) and (device-height: 1024px) and (orientation: landscape) and (-webkit-device-pixel-ratio: 1)\"\r\n        rel=\"apple-touch-startup-image\" />\r\n    <!-- iPad (Retina) -->\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-icon-144x144.png?v=24.7.15\"\r\n        sizes=\"144x144\" rel=\"apple-touch-icon\" />\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-startup-image-1536x2008.png?v=24.7.15\"\r\n        media=\"(device-width: 768px) and (device-height: 1024px) and (orientation: portrait) and (-webkit-device-pixel-ratio: 2)\"\r\n        rel=\"apple-touch-startup-image\" />\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-startup-image-1496x2048.png?v=24.7.15\"\r\n        media=\"(device-width: 768px) and (device-height: 1024px) and (orientation: landscape) and (-webkit-device-pixel-ratio: 2)\"\r\n        rel=\"apple-touch-startup-image\" />\r\n    <link rel=\"stylesheet\" href=\"/RaidoMobile/Styles/Style.css?v=24.7.15\"\r\n        type=\"text/css\" />\r\n    <link rel=\"stylesheet\" href=\"/RaidoMobile/Styles/Mobile.css?v=24.7.15\"\r\n        type=\"text/css\" />\r\n    <link rel=\"stylesheet\" href=\"/RaidoMobile/Styles/leftmenu.css?v=24.7.15\"\r\n        type=\"text/css\" />\r\n\r\n    <script type=\"text/javascript\" src=\"/RaidoMobile/Scripts/jquery-1.11.3.min.js?v=24.7.15\"></script>\r\n    <script type=\"text/javascript\" src=\"/RaidoMobile/Scripts/jquery-migrate-1.2.1.min.js?v=24.7.15\"></script>\r\n    <script type=\"text/javascript\" src=\"/RaidoMobile/Scripts/jquery.touchslider.min.js?v=24.7.15\"></script>\r\n    <script type=\"text/javascript\" src=\"/RaidoMobile/Scripts/RaidoMobile.js?v=24.7.15\"></script>\r\n    <script type=\"text/javascript\" src=\"/RaidoMobile/Scripts/moment.js?v=24.7.15\"></script>\r\n    <script type=\"text/javascript\" src=\"/RaidoMobile/Scripts/ScrollToPlugin.js?v=24.7.15\"></script>\r\n    <script type=\"text/javascript\" src=\"/RaidoMobile/Scripts/jquery-ui/js/jquery-ui.min.js?v=24.7.15\"></script>\r\n    \r\n    <script>\r\n        const __ENV__ = {\r\n            VERSION: \"24.7.15\",\r\n            APPLICATION_URL: \"https://poe.noc.vmc.navblue.cloud/RaidoMobile\",\r\n            APPLICATION_PATH: \"/RaidoMobile\",\r\n            PAGE_URL: \"https://poe.noc.vmc.navblue.cloud\",\r\n            SERVICE_WORKER_URL: ''\r\n        };\r\n    </script>\r\n    <script src=\"/RaidoMobile/Scripts/global-store.js\" type=\"module\"></script>\r\n    <script src=\"/RaidoMobile/Scripts/trade-badge.js\" type=\"module\"></script>\r\n    \r\n    <script>\r\n        __ENV__.SERVICE_WORKER_URL = `/RaidoMobile/open-time.sw.js`\r\n        __ENV__.SERVICE_WORKER_URL = `/RaidoMobile/open-time.sw.js?env=${JSON.stringify(__ENV__)}`\r\n    </script>\r\n    <script src=\"/RaidoMobile/Scripts/open-times.js\" type=\"module\"></script>\r\n    <style type=\"text/css\">\r\n        html {\r\n          scroll-behavior: smooth;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div id=\"header\" class=\"avxgrad_yellow alwaysOverlay\">\r\n\t\r\n        <div class=\"topbar-float topbar-left\">\r\n            <div id=\"goBackLink\" class=\"go-back-button-container\">\r\n\t\t\r\n                <button type=\"button\" class=\"go-back-button\"  style=\"background: url('/RaidoMobile/Images/back.png') center center;\">\r\n                    <div class=\"overlay\"></div>\r\n                </button>\r\n            \r\n\t</div>\r\n        </div>\r\n        <div class=\"topbar-float topbar-center\">\r\n            <a href=\"/RaidoMobile/MainPage.aspx\">\r\n                <img src=\"/RaidoMobile/Images/logo.png\" alt=\"Company Logo\" style=\"max-height: 30px\" /></a>\r\n        </div>\r\n        <div class=\"topbar-float topbar-right\" style=\"position:relative;\" >\r\n            <div id=\"tradeCounter\" class=\"topbar-button\" style=\"position:relative; display: inline-block;\">\r\n\t\t\r\n                <x-trade-badge url=\"Grids/HumanResources/Trade.aspx\"></x-trade-badge>\r\n            \r\n\t</div>\r\n            <a id=\"linkAbout\" class=\"topbar-button\" href=\"../../About.aspx\" style=\"position:relative;\"><img src=\"../../Images/About.png\" alt=\"\" style=\"border-width:0px;\" /></a>\r\n            <a href=\"/RaidoMobile/Logout.aspx\"  class=\"topbar-button\">\r\n            <img src=\"/RaidoMobile/Images/Logout.png\" alt=\"Logout\" /></a>\r\n        </div>\r\n        <br style=\"clear: left;\" />\r\n    \r\n</div>\r\n    <div id=\"wrapper\" class=\"avxgrad_gray\">\r\n\t\r\n        <div style=\"padding: 10px;\">\r\n            <form name=\"form\" method=\"post\" action=\"./OpenTime.aspx?rnd=9635\" id=\"form\">\r\n\t<div>\r\n\t<input type=\"hidden\" name=\"__VIEWSTATE\" id=\"__VIEWSTATE\" value=\"\" />\r\n\t</div>\r\n\r\n\t<div>\r\n\r\n\t\t<input type=\"hidden\" name=\"__VIEWSTATEGENERATOR\" id=\"__VIEWSTATEGENERATOR\" value=\"F15DA6DB\" />\r\n\t</div>\t\r\n                \r\n    <x-open-times></x-open-times>\r\n\r\n            </form>\r\n        </div>\r\n        \r\n        \r\n        \r\n        \r\n</div>\r\n    <div id=\"menuButtonHolder\">\r\n        <a href=\"javascript:return false;\" id=\"linkMenu\" class=\"NoAction\">\r\n            <img src=\"/RaidoMobile/Images/menu_icon.png\" alt=\"Menu\" /></a>\r\n    </div>\r\n    <div class=\"fadedGreyBackground\">\r\n    </div>\r\n    <div class=\"fadedGreyBackgroundSpin\">\r\n    </div>\r\n    <div id=\"tabMasterMenu\" class=\"avxyellow\" style=\"position: fixed; top: 45px; left: 0px; width: 280px; z-index: 99; padding: 2px 2px 2px 2px; display: none;\">\r\n        <div id=\"menuslider\" class=\"touchslider\">\r\n            <div class=\"touchslider-viewport\" style=\"overflow: hidden;\">\r\n                <div>\r\n                    <div class=\"touchslider-item\"><div class=\"header\">Human Resource</div><ul class='container'>\r\n\r\n<li><a href=\"/RaidoMobile/Dialogues/HumanResources/DownloadRosterAsExternalCalendar.aspx\"><div class='leftmenu-SYFU448'></div>Download roster</a></li>\r\n<li><a href=\"/RaidoMobile/Grids/HumanResources/HumanResourcesLog.aspx\"><div class='leftmenu-SYFU407'></div>HR Log</a></li>\r\n<li><a href=\"/RaidoMobile/Grids/HumanResources/HumanResourceMyBalance.aspx\"><div class='leftmenu-SYFU318'></div>My Balance</a></li>\r\n<li><a href=\"/RaidoMobile/Grids/HumanResources/Contact.aspx\"><div class='leftmenu-SYFU246'></div>My Contact Details</a></li>\r\n<li><a href=\"/RaidoMobile/Grids/HumanResources/HumanResourceMyDocs.aspx\"><div class='leftmenu-SYFU188'></div>My Documents</a></li>\r\n<li><a hre