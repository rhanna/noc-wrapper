            "size": 198205,
            "mimeType": "text/html",
            "text": "<!DOCTYPE HTML>\r\n<html>\r\n<head>\r\n    <script type='text/javascript' src=\"/RaidoMobile/AppInsights/ai.2.min.js\"></script>\r\n    <script type='text/javascript'>\r\n        let appInsights = new Microsoft.ApplicationInsights.ApplicationInsights({ config: {\r\n            instrumentationKey:\"80642c30-ac26-49de-9af5-cfb7fc3ae735\"\r\n        }});      \r\n        \r\n        appInsights.loadAppInsights();         \r\n                \r\n        appInsights.setAuthenticatedUserContext(\"11538\", \"11538\");  \r\n        appInsights.context.user.id = \"11538\";\r\n        \r\n        appInsights.addTelemetryInitializer(function (envelope) {\r\n           envelope.tags[\"ai.cloud.role\"] = \"Raido Mobile Browser\";\r\n           envelope.tags[\"ai.cloud.roleInstance\"] = \"910401\";\r\n        });\r\n\r\n        appInsights.trackPageView();\r\n    </script>\r\n\r\n    <style>\r\n        .dot {\r\n            height: 14px;\r\n            width: 14px;\r\n            background-color: red;\r\n            border-radius: 50%;\r\n            display: inline-block;\r\n            position: absolute;\r\n            right: 4px;\r\n            bottom: 0px;\r\n        }\r\n        .dotCounter {\r\n            color: white;\r\n              font-size:9px;\r\n              position:absolute;\r\n              bottom:3px;\r\n              right:4px;\r\n        }\r\n       \r\n    </style>\r\n\r\n    <meta name=\"viewport\" content=\"initial-scale=1, maximum-scale=1, user-scalable=no, width=device-width\" /><meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black\" /><meta name=\"apple-mobile-web-app-capable\" content=\"yes\" /><meta http-equiv=\"X-UA-Compatible\" content=\"IE=9\" /><title>\r\n\tN-OC | Mobile (POE-RATATOSK.NOC)\r\n</title>\r\n    <!-- iPhone -->\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-icon-57x57.png?v=24.7.15\"\r\n        sizes=\"57x57\" rel=\"apple-touch-icon\" />\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-startup-image-320x460.png?v=24.7.15\"\r\n        media=\"(device-width: 320px) and (device-height: 480px) and (-webkit-device-pixel-ratio: 1)\"\r\n        rel=\"apple-touch-startup-image\" />\r\n    <!-- iPhone (Retina) -->\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-icon-114x114.png?v=24.7.15\"\r\n        sizes=\"114x114\" rel=\"apple-touch-icon\" />\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-startup-image-640x920.png?v=24.7.15\"\r\n        media=\"(device-width: 320px) and (device-height: 480px) and (-webkit-device-pixel-ratio: 2)\"\r\n        rel=\"apple-touch-startup-image\" />\r\n    <!-- iPhone 5 -->\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-startup-image-640x1096.png?v=24.7.15\"\r\n        media=\"(device-width: 320px) and (device-height: 568px) and (-webkit-device-pixel-ratio: 2)\"\r\n        rel=\"apple-touch-startup-image\" />\r\n    <!-- iPad -->\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-icon-72x72.png?v=24.7.15\"\r\n        sizes=\"72x72\" rel=\"apple-touch-icon\" />\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-startup-image-768x1004.png?v=24.7.15\"\r\n        media=\"(device-width: 768px) and (device-height: 1024px) and (orientation: portrait) and (-webkit-device-pixel-ratio: 1)\"\r\n        rel=\"apple-touch-startup-image\" />\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-startup-image-748x1024.png?v=24.7.15\"\r\n        media=\"(device-width: 768px) and (device-height: 1024px) and (orientation: landscape) and (-webkit-device-pixel-ratio: 1)\"\r\n        rel=\"apple-touch-startup-image\" />\r\n    <!-- iPad (Retina) -->\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-icon-144x144.png?v=24.7.15\"\r\n        sizes=\"144x144\" rel=\"apple-touch-icon\" />\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-startup-image-1536x2008.png?v=24.7.15\"\r\n        media=\"(device-width: 768px) and (device-height: 1024px) and (orientation: portrait) and (-webkit-device-pixel-ratio: 2)\"\r\n        rel=\"apple-touch-startup-image\" />\r\n    <link href=\"/RaidoMobile/Images/iOS/apple-touch-startup-image-1496x2048.png?v=24.7.15\"\r\n        media=\"(device-width: 768px) and (device-height: 1024px) and (orientation: landscape) and (-webkit-device-pixel-ratio: 2)\"\r\n        rel=\"apple-touch-startup-image\" />\r\n    <link rel=\"stylesheet\" href=\"/RaidoMobile/Styles/Style.css?v=24.7.15\"\r\n        type=\"text/css\" />\r\n    <link rel=\"stylesheet\" href=\"/RaidoMobile/Styles/Mobile.css?v=24.7.15\"\r\n        type=\"text/css\" />\r\n    <link rel=\"stylesheet\" href=\"/RaidoMobile/Styles/leftmenu.css?v=24.7.15\"\r\n        type=\"text/css\" />\r\n\r\n    <script type=\"text/javascript\" src=\"/RaidoMobile/Scripts/jquery-1.11.3.min.js?v=24.7.15\"></script>\r\n    <script type=\"text/javascript\" src=\"/RaidoMobile/Scripts/jquery-migrate-1.2.1.min.js?v=24.7.15\"></script>\r\n    <script type=\"text/javascript\" src=\"/RaidoMobile/Scripts/jquery.touchslider.min.js?v=24.7.15\"></script>\r\n    <script type=\"text/javascript\" src=\"/RaidoMobile/Scripts/RaidoMobile.js?v=24.7.15\"></script>\r\n    <script type=\"text/javascript\" src=\"/RaidoMobile/Scripts/moment.js?v=24.7.15\"></script>\r\n    <script type=\"text/javascript\" src=\"/RaidoMobile/Scripts/ScrollToPlugin.js?v=24.7.15\"></script>\r\n    <script type=\"text/javascript\" src=\"/RaidoMobile/Scripts/jquery-ui/js/jquery-ui.min.js?v=24.7.15\"></script>\r\n    \r\n    <script>\r\n        const __ENV__ = {\r\n            VERSION: \"24.7.15\",\r\n            APPLICATION_URL: \"https://poe.noc.vmc.navblue.cloud/RaidoMobile\",\r\n            APPLICATION_PATH: \"/RaidoMobile\",\r\n            PAGE_URL: \"https://poe.noc.vmc.navblue.cloud\",\r\n            SERVICE_WORKER_URL: ''\r\n        };\r\n    </script>\r\n    <script src=\"/RaidoMobile/Scripts/global-store.js\" type=\"module\"></script>\r\n    <script src=\"/RaidoMobile/Scripts/trade-badge.js\" type=\"module\"></script>\r\n    \r\n    <script type=\"text/javascript\">\r\n\r\n        $(document).ready(function () {\r\n            $('.ItemHeader').live('click', function () {\r\n                $(this).parent().children('.ItemDetails').slideToggle();\r\n            });\r\n\r\n        });\r\n\r\n    </script>\r\n    <style type=\"text/css\">\r\n        .ItemHeader, .ItemHeader table\r\n        {\r\n            height: 40px;\r\n        }\r\n        \r\n        .ItemHeader td:nth-child(1), .ItemHeader td:nth-child(2), .ItemHeader td:nth-child(4), .ItemHeader td:nth-child(5)\r\n        {\r\n            width: 12%;\r\n        }\r\n        \r\n        .ItemHeader td:nth-child(3)\r\n        {\r\n            width: 20%;\r\n        }\r\n        \r\n        .ItemHeader td:nth-child(6), .ItemHeader td:nth-child(7), .ItemHeader td:nth-child(8)\r\n        {\r\n            width: 7%;\r\n        }\r\n        .ItemHeader td:nth-child(9)\r\n        {\r\n            width: 8%;\r\n        }\r\n        .ItemHeader td:nth-child(10)\r\n        {\r\n            width: 3%;\r\n        }\r\n        .triangle\r\n        {\r\n            display: inline;\r\n            float: right;\r\n            width: 0;\r\n            height: 0;\r\n            border-style: solid;\r\n            border-width: 0 20px 20px 0;\r\n            position: relative;\r\n            top: -10px;\r\n            right: 0;\r\n        }\r\n        #panelUpperWrapper\r\n        {\r\n            float: left;\r\n            width: 49%;\r\n        }\r\n        #panelLowerWrapper\r\n        {\r\n            float: right;\r\n            width: 50%;\r\n        }\r\n        \r\n        @media screen and (max-width: 800px)\r\n        {\r\n            #panelUpperWrapper\r\n            {\r\n                float: none;\r\n                width: auto;\r\n            }\r\n            #panelLowerWrapper\r\n            {\r\n                float: none;\r\n                width: auto;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div id=\"header\" class=\"avxgrad_yellow alwaysOverlay\">\r\n\t\r\n        <div class=\"topbar-float topbar-left\">\r\n            <div id=\"goBackLink\" class=\"go-back-button-container\">\r\n\t\t\r\n                <button type=\"button\" class=\"go-back-button\"  style=\"background: url('/RaidoMobile/Images/back.png') center center;\">\r\n                    <div class=\"overlay\"></div>\r\n                </button>\r\n            \r\n\t</div>\r\n        </div>\r\n        <div class=\"topbar-float topbar-center\">\r\n            <a href=\"/RaidoMobile/MainPage.aspx\">\r\n                <img src=\"/RaidoMobile/Images/logo.png\" alt=\"Company Logo\" style=\"max-height: 30px\" /></a>\r\n        </div>\r\n        <div class=\"topbar-float topbar-right\" style=\"position:relative;\" >\r\n            <div id=\"tradeCounter\" class=\"topbar-button\" style=\"position:relative; display: inline-block;\">\r\n\t\t\r\n                <x-trade-badge url=\"Grids/HumanResources/Trade.aspx\"></x-trade-badge>\r\n            \r\n\t</div>\r\n            <a id=\"linkAbout\" class=\"topbar-button\" href=\"../../About.aspx\" style=\"position:relative;\"><img src=\"../../Images/About.png\" alt=\"\" style=\"border-width:0px;\" /></a>\r\n            <a href=\"/RaidoMobile/Logout.aspx\"  class=\"topbar-button\">\r\n            <img src=\"/RaidoMobile/Images/Logout.png\" alt=\"Logout\" /></a>\r\n        </div>\r\n        <br style=\"clear: left;\" />\r\n    \r\n</div>\r\n    <div id=\"wrapper\" class=\"avxgrad_gray\">\r\n\t\r\n        <div style=\"padding: 10px;\">\r\n            <form name=\"form\" method=\"post\" action=\"./StationOperations.aspx?rnd=9662\" id=\"form\">\r\n\t<div>\r\n\t<input type=\"hidden\" name=\"__VIEWSTATE\" id=\"__VIEWSTATE\" value=\"\" />\r\n\t</div>\r\n\r\n\t<div>\r\n\r\n\t\t<input type=\"hidden\" name=\"__VIEWSTATEGENERATOR\" id=\"__VIEWSTATEGENERATOR\" value=\"5897C965\" />\r\n\t\t<input type=\"hidden\" name=\"__EVENTVALIDATION\" id=\"__EVENTVALIDATION\" value=\"\" />\r\n\t</div>\t\r\n                \r\n    <div id=\"MasterMain_PageHeader_PageHeader\" class=\"PageHeader\">\r\n\t\t\r\n    <table>\r\n        <tr>\r\n            <td id=\"MasterMain_PageHeader_PageHeaderLeft\" style=\"width: 15%;\"></td>\r\n\t\t\r\n            <td id=\"MasterMain_PageHeader_PageHeaderCenter\" style=\"width: 70%;\"><span>Station Operations</span></td>\r\n\t\t\r\n            <td id=\"MasterMain_PageHeader_PageHeaderRight\" style=\"width: 15%;\"></td>\r\n\t\t\r\n        </tr>\r\n    </table>\r\n\r\n\t</div>\r\n\r\n    <div id=\"MasterMain_SelectorPanel\" class=\"SelectorBox\">\r\n\t\t\r\n        <div id=\"MasterMain_Panel8\" class=\"Float\">\r\n\t\t\t\r\n            <span id=\"MasterMain_lbDate\" class=\"leftalignedlabel\">Date</span><br />\r\n            \r\n\r\n<script type=\"text/javascript\" src=\"/RaidoMobile/Scripts/DateTime/newDateSpan2DigitYearMax.js\"></script>\r\n<script type=\"text/javascript\" src=\"/RaidoMobile/Scripts/jquery-ui/js/jquery-ui-1.10.4.custom.js\"></script>\r\n<link rel=\"Stylesheet\" type=\"text/css\" href=\"/RaidoMobile/Scripts/jquery-ui/css/ui-lightness/jquery-ui-1.10.4.custom.min.css\" />\r\n\r\n<input type=\"hidden\" name=\"ctl00$MasterMain$tbDate$hfMonthShortNames\" id=\"MasterMain_tbDate_hfMonthShortNames\" value=\"JAN,FEB,MAR,APR,MAY,JUN,JUL,AUG,SEP,OCT,NOV,DEC\" />\r\n<input type=\"hidden\" name=\"ctl00$MasterMain$tbDate$hfWdMinNames\" id=\"MasterMain_tbDate_hfWdMinNames\" value=\"Su,Mo,Tu,We,Th,Fr,Sa\" />\r\n<input type=\"hidden\" name=\"ctl00$MasterMain$tbDate$hfCalorder\" id=\"MasterMain_tbDate_hfCalorder\" value=\"dmy\" />\r\n<input type=\"hidden\" name=\"ctl00$MasterMain$tbDate$hfReadonly\" id=\"MasterMain_tbDate_hfReadonly\" />\r\n<input type=\"hidden\" name=\"ctl00$MasterMain$tbDate$hfMaxTwoDigitYear\" id=\"MasterMain_tbDate_hfMaxTwoDigitYear\" value=\"2079\" />\r\n<div id=\"MasterMain_tbDate_wrapper\" style=\"float: left;\">\r\n    <input type=\"hidden\" name=\"ctl00$MasterMain$tbDate$hdnAllowEmptyDates\" id=\"MasterMain_tbDate_hdnAllowEmptyDates\" value=\"false\" />\r\n    <span id=\"MasterMain_tbDate_labelDate\" class=\"leftalignedlabel datelabel\"></span>\r\n    <div style=\"float: left;\">\r\n        <div style=\"float: left;\">\r\n            <input name=\"ctl00$MasterMain$tbDate$DateFieldTextBox\" type=\"text\" value=\"28APR26\" maxlength=\"50\" id=\"MasterMain_tbDate_DateFieldTextBox\" class=\"inputRaido jqiatadate\" onFocus=\"javascript:this.select()\" onkeydown=\"javascript:this.setAttribute(&#39;validate&#39;,&#39;true&#39;)\" validate=\"false\" onBlur=\"javascript:MasterMain_tbDate_DateFieldTextBoxtryValidate(this)\" style=\"width:70px;\" />\r\n        </div>\r\n        <div style=\"float: left;\" class=\"jqsingledate\">\r\n            <input type=\"hidden\" name=\"ctl00$MasterMain$tbDate$hfDate\" id=\"MasterMain_tbDate_hfDate\" value=\"20260428\" />\r\n        </div>\r\n        <div style=\"float: left;\" class=\"jqsingledate\">\r\n            \r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<script type=\"text/javascript\" id=\"loadJavascript\">\r\n    var calorder = \"ymd\";\r\n    var MasterMain_tbDate_DateFieldTextBoxlimiter = null;\r\n    var MasterMain_tbDate_DateFieldTextBoxinPast = false;\r\n    \r\n    if (typeof (Sys) != 'undefined') {\r\n        Sys.WebForms.PageRequestManager.getInstance().add_endRequest(MasterMain_tbDate_DateFieldTextBoxWork);\r\n    }\r\n\r\n    $(document).ready(function () {\r\n        MasterMain_tbDate_DateFieldTextBoxWork();\r\n    });\r\n\r\n    function MasterMain_tbDate_DateFieldTextBoxWork() {\r\n        MasterMain_tbDate_DateFieldTextBoxSetItAlUp();\r\n        var tmpCal = $('#MasterMain_tbDate_hfCalorder').val();\r\n        if (tmpCal != null && tmpCal != \"\") {\r\n            calorder = tmpCal;\r\n        }\r\n    }\r\n\r\n    function MasterMain_tbDate_DateFieldTextBoxSetItAlUp() {\r\n        if (document.getElementById('MasterMain_tbDate_hdnAllowEmptyDates') != null) {\r\n            var AllowEmptyDateField = document.getElementById('MasterMain_tbDate_hdnAllowEmptyDates').value.toLowerCase();\r\n            if (!AllowEmptyDateField) { AllowEmptyDateField = \"\"; }\r\n\r\n            var ids = {\r\n                dp: 'MasterMain_tbDate_DateFieldTextBox',\r\n                hf: 'MasterMain_tbDate_hfDate',\r\n                hfMonthShortNames: \"MasterMain_tbDate_hfMonthShortNames\",\r\n                hfWdMinNames: \"MasterMain_tbDate_hfWdMinNames\",\r\n                hfMaxTwoDigitYear: 'MasterMain_tbDate_hfMaxTwoDigitYear',\r\n                buttonURL: '/RaidoMobile/Images/calendar.png'\r\n            }\r\n            $(function () {\r\n                if (document.getElementById(\"MasterMain_tbDate_hfReadonly\").value != \"true\") {\r\n                    $.SetConfig('#' + ids.hfMonthShortNames, '#' + ids.hfWdMinNames, ids.buttonURL);\r\n                    $.DateChecker('#' + ids.dp, '#' + ids.hf, '', AllowEmptyDateField);\r\n                    $('#' + ids.hf).datepicker(\"option\", \"buttonText\", '');\r\n                    if (MasterMain_tbDate_DateFieldTextBoxlimiter) {\r\n                        $('#' + ids.hf).datepicker(\"option\", \"minDate\", MasterMain_tbDate_DateFieldTextBoxlimiter);\r\n                    }\r\n                } else {\r\n                    document.getElementById(ids.dp).value = FromInternalDateToIATADate(document.getElementById(ids.hf).value);\r\n                }\r\n            });\r\n\r\n            // fix an exception in new jquery ui \r\n            if ($('#' + ids.hf).val().match(\"0000$\")) $('#' + ids.hf).val($('#' + ids.hf).val().slice(0, -4));\r\n        }\r\n    }\r\n\r\n    function MasterMain_tbDate_DateFieldTextBoxtryValidate() {\r\n        var control = document.getElementById(\"MasterMain_tbDate_DateFieldTextBox\");\r\n        var maxTwoDigitYear = document.getElementById(\"MasterMain_tbDate_hfMaxTwoDigitYear\").value;\r\n        if (control.getAttribute('Validate') == 'true') {\r\n            var tmpDate = ParseDate(control.value, calorder, maxTwoDigitYear);\r\n            if (tmpDate != null) {\r\n                var value = ToInternalDate(tmpDate);\r\n                if (MasterMain_tbDate_DateFieldTextBoxlimiter) {\r\n                    var tmpOld = FromInternalDate(MasterMain_tbDate_DateFieldTextBoxlimiter);\r\n                    if (tmpOld > tmpDate) {\r\n                        value = MasterMain_tbDate_DateFieldTextBoxlimiter;\r\n                    }\r\n                }\r\n\r\n                $('#MasterMain_tbDate_hfDate').val(value);\r\n\r\n                document.getElementById(\"MasterMain_tbDate_DateFieldTextBox\").value = ToIATADate(tmpDate);\r\n\r\n                $('body').trigger(\"MasterMain_tbDate_DateFieldTextBoxUpdate\");\r\n            }\r\n            else if (document.getElementById('MasterMain_tbDate_hdnAllowEmptyDates').value == 'True') {\r\n                document.getElementById(\"MasterMain_tbDate_DateFieldTextBox\").value = \"\";\r\n                $('#MasterMain_tbDate_hfDate').val(\"\");\r\n            }\r\n            else {\r\n                alert(\"Date in unrecognized format!\");\r\n\r\n                var value = FromInternalDate($('#MasterMain_tbDate_hfDate').val());\r\n                document.getElementById(\"MasterMain_tbDate_DateFieldTextBox\").value = ToIATADate(value);\r\n            }\r\n        }\r\n\r\n        var tmpDate = ParseDate(control.value, calorder, maxTwoDigitYear);\r\n        if (tmpDate != null) {\r\n            if (tmpDate <= new Date('1/1/1753 12:00:00 AM') || tmpDate > new Date('6/6/2079 12:00:00 AM')) {\r\n                alert(\"Date is out of range. It shall be between \" + ToIATADate(new Date('1/1/1753 12:00:00 AM')) + \" and \" + ToIATADate(new Date('6/6/2079 12:00:00 AM')));\r\n            }\r\n        }\r\n    }\r\n</script>\r\n\r\n&nbsp;\r\n        \r\n\t\t</div>\r\n        <div id=\"MasterMain_Panel1\" class=\"Float\">\r\n\t\t\t\r\n            <span id=\"MasterMain_lbStation\" class=\"leftalignedlabel\">Station</s